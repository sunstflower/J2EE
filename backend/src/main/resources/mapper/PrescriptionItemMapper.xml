<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.drugmanagement.mapper.PrescriptionItemMapper">

    <resultMap id="PrescriptionItemVoResultMap" type="com.example.drugmanagement.vo.prescription.PrescriptionItemVO">
        <id property="id" column="id"/>
        <result property="drugId" column="drug_id"/>
        <result property="drugCode" column="drug_code"/>
        <result property="drugName" column="drug_name"/>
        <result property="dosage" column="dosage"/>
        <result property="frequency" column="frequency"/>
        <result property="days" column="days"/>
        <result property="quantity" column="quantity"/>
    </resultMap>

    <insert id="insertBatch">
        INSERT INTO prescription_item (
            prescription_id,
            drug_id,
            dosage,
            frequency,
            days,
            quantity,
            created_by,
            updated_by,
            deleted
        )
        VALUES
        <foreach collection="items" item="item" separator=",">
            (
                #{item.prescriptionId},
                #{item.drugId},
                #{item.dosage},
                #{item.frequency},
                #{item.days},
                #{item.quantity},
                #{item.createdBy},
                #{item.updatedBy},
                #{item.deleted}
            )
        </foreach>
    </insert>

    <select id="findByPrescriptionId" resultMap="PrescriptionItemVoResultMap">
        SELECT
            pi.id,
            pi.drug_id,
            d.drug_code,
            d.drug_name,
            pi.dosage,
            pi.frequency,
            pi.days,
            pi.quantity
        FROM prescription_item pi
        INNER JOIN drug d ON d.id = pi.drug_id
        WHERE pi.prescription_id = #{prescriptionId}
          AND pi.deleted = 0
          AND d.deleted = 0
        ORDER BY pi.id ASC
    </select>
</mapper>
